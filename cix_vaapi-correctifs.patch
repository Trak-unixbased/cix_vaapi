+        --sysroot) SYSROOT="${2:?}"; shift ;;
+        --cme) CME="${2:?}"; shift ;;
+        --mvx-include) MVX_INCLUDE="${2:?}"; shift ;;
+        --version) VERSION="${2:?}"; shift ;;
+        --revision) DEB_REVISION="${2:?}"; shift ;;
