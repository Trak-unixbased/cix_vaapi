diff --git a/packaging/70-cix-vaapi.rules b/packaging/70-cix-vaapi.rules
new file mode 100644
index 0000000..ec4c74a
--- /dev/null
+++ b/packaging/70-cix-vaapi.rules
@@ -0,0 +1,9 @@
+# CIX VA-API driver (cix_drv_video.so)
+#
+# Surfaces are allocated from the DMA-BUF heaps. On many distributions
+# /dev/dma_heap/* is root-only (0600), so VA-API applications failed with
+# "Failed to allocate ... DMA-BUF". Give access to the "video" group and to
+# the user logged in on the local seat (uaccess).
+SUBSYSTEM=="dma_heap", KERNEL=="system", GROUP="video", MODE="0660", TAG+="uaccess"
+SUBSYSTEM=="dma_heap", KERNEL=="linux,cma", GROUP="video", MODE="0660", TAG+="uaccess"
+SUBSYSTEM=="dma_heap", KERNEL=="reserved", GROUP="video", MODE="0660", TAG+="uaccess"
diff --git a/packaging/90-cix-vaapi.conf b/packaging/90-cix-vaapi.conf
new file mode 100644
index 0000000..6d8fb4b
--- /dev/null
+++ b/packaging/90-cix-vaapi.conf
@@ -0,0 +1,4 @@
+# systemd environment.d(5): selects the CIX VA-API driver for graphical
+# user sessions. The DRM render node of the board belongs to the GPU, so libva
+# cannot guess the driver name from it.
+LIBVA_DRIVER_NAME=cix
diff --git a/packaging/build-deb.sh b/packaging/build-deb.sh
new file mode 100755
index 0000000..320b248
--- /dev/null
+++ b/packaging/build-deb.sh
@@ -0,0 +1,408 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: Apache-2.0
+#
+# Builds a Debian package (.deb) of the CIX VA-API driver.
+#
+# Native build, on the board (Orange Pi 6 Plus, Ubuntu 26.04 arm64):
+#     ./packaging/build-deb.sh --install-deps
+#     sudo apt install ./dist/cix-va-driver_*_arm64.deb
+#
+# Cross build from an x86_64 host (arm64 multiarch dev packages or a sysroot):
+#     ./packaging/build-deb.sh --cross [--sysroot /path/to/arm64-rootfs]
+#
+# Run "./packaging/build-deb.sh --help" for all the options.
+
+set -euo pipefail
+umask 022
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+SRC_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
+
+PKG_NAME="cix-va-driver"
+HOMEPAGE="https://github.com/Trak-unixbased/cix_vaapi"
+MAINTAINER="${DEBFULLNAME:-CIX VA-API packager} <${DEBEMAIL:-root@localhost}>"
+DEB_REVISION="1"
+
+BUILD_TYPE="Release"
+CROSS=0
+SYSROOT=""
+CME="AUTO"
+MVX_INCLUDE=""
+OUT_DIR="$SRC_DIR/dist"
+JOBS="$(nproc 2>/dev/null || echo 4)"
+DO_STRIP=1
+DO_LINT=0
+INSTALL_DEPS=0
+INSTALL_PKG=0
+VERSION=""
+ALLOW_ANY_ARCH=0
+CLEAN=0
+
+log()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
+warn() { printf '\033[1;33mWARNING:\033[0m %s\n' "$*" >&2; }
+die()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }
+
+usage() {
+    cat <<EOF
+Usage: $(basename "$0") [options]
+
+Builds ${PKG_NAME}_<version>_arm64.deb in ${OUT_DIR}.
+
+Options:
+  --cross                 Cross-compile for arm64 with cc.cmake (aarch64-linux-gnu-g++).
+  --sysroot DIR           arm64 sysroot used for a cross build.
+  --cme AUTO|ON|OFF       Video processing through libcme (default: AUTO).
+  --mvx-include DIR       Directory containing mvx-v4l2-controls.h (optional).
+  --version VERSION       Upstream version (default: CMake project version + git).
+  --revision N            Debian revision (default: ${DEB_REVISION}).
+  --maintainer "N <m>"    Maintainer field (default: \$DEBFULLNAME <\$DEBEMAIL>).
+  --build-type TYPE       CMake build type (default: ${BUILD_TYPE}).
+  --output DIR            Output directory (default: ${OUT_DIR}).
+  --jobs N                Parallel build jobs (default: ${JOBS}).
+  --no-strip              Keep the debug symbols in the driver.
+  --clean                 Remove the previous build directory first.
+  --lint                  Run lintian on the result (if installed).
