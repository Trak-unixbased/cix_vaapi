+if [ "$CROSS" -eq 1 ]; then
+    CMAKE_ARGS+=(-DCMAKE_TOOLCHAIN_FILE="$SRC_DIR/cc.cmake")
+    if [ -n "$SYSROOT" ]; then
+        CMAKE_ARGS+=(-DCMAKE_SYSROOT="$SYSROOT")
+    fi
+fi
