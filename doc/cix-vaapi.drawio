                    <mxGeometry x="380" y="350" width="50" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IlsXHJPclxPX1hFeky2A-3" value="HEVC" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="440" y="350" width="50" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IlsXHJPclxPX1hFeky2A-5" value="Surface Pool" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="240" y="260" width="100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="IlsXHJPclxPX1hFeky2A-6" value="Buffer Pool" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="240" y="310" width="100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="IlsXHJPclxPX1hFeky2A-7" value="Image Pool" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="240" y="360" width="100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="IlsXHJPclxPX1hFeky2A-8" value="&lt;div style=&quot;forced-color-adjust: none; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;ul style=&quot;forced-color-adjust: none; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Surface memory and surface ID&lt;/font&gt;&lt;/li&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;surface memory bind to surface ID when:&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;surface is created in vaMapBuffer()&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;surface is created in vaExportSurfaceHandle()&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;surface is dequeued from capture port (decode output)&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;surface memory unbind to surface ID (by setting ID to VA_INVALID_SURFACE) when:&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;surface ID is got in vaBeginPicture() of decoder as this ID could be bind to a different surface later.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;V4L2 encoder doesn&#39;t change surface memory and ID binding status - static binding&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;vaCreateSurface2() only allocate surface IDs but not really allocate surface memory&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;surface memory is allocated when first time it is used.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Surface ID and context&lt;/font&gt;&lt;/li&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;V4L2 decoder context own a surface ID when this ID is got in vaBeginPicture()&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;V4L2 decoder context free a surface ID after corresponding buffer is dequeued.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Surface Pool&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Created in device&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Used by device, contexts, V4L2 ports&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;One device may have multiple surface pools&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;All the surfaces in a surface pool have same attributes: width, height, format, etc.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Buffer Pool&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;All the buffers of a device is maintained in a single buffer pool.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Used by device and contexts&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Default size 64&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Used to map context, buffer type and buffer memory (if any) to buffer ID.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Image Pool&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;All the images of a device is maintained in a single image pool&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;used by device&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Default size 64&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none; padding: 3px 0px; color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Used to map surface id to image id (image always uses surface&#39;s memory, so cropping from surface is not supported.)&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;labelBackgroundColor=none;textShadow=0;labelBorderColor=none;" vertex="1" parent="1">
                    <mxGeometry x="730" y="120" width="560" height="700" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>